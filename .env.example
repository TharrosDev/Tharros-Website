# THARROS — environment scaffold. Copy to .env.local for development.

# Canonical origin. Used for metadataBase, sitemap, robots and JSON-LD @ids.
NEXT_PUBLIC_SITE_URL=https://tharros.com

# ---- Payment provider (NOT CONNECTED) ----
# Checkout is built up to the payment step and stops there on purpose. Wiring a
# provider means adding its key here and implementing the server route that the
# payment step calls. Never expose a secret key with a NEXT_PUBLIC_ prefix.
# PAYMENT_PROVIDER_SECRET_KEY=

# ---- Search engine verification ----
# Paste only the `content` value from the verification meta tag, not the element.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
